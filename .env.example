# Скопируйте этот файл в .env рядом с программой и впишите свои значения.
# Файл .env содержит секреты и не попадает в git. Без него программа запускается,
# но письма с кодом не отправляются, а адрес дома сохраняется так, как введён.

# Отправка писем через Google Apps Script (работает при включённом VPN, порт 443).
# Адрес развёрнутого скрипта (оканчивается на /exec) и секретное слово из скрипта (TOKEN).
APPS_SCRIPT_URL=
APPS_SCRIPT_TOKEN=

# Запасной способ: SMTP Gmail (используется, если APPS_SCRIPT_URL пуст).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SENDER_NAME=Система управления ТСЖ

# Ключ API DeepSeek для оформления адреса дома (необязательно).
DEEPSEEK_API_KEY=

# Регион и город по умолчанию для адреса.
DEFAULT_REGION=Новосибирская область
DEFAULT_CITY=Новосибирск
